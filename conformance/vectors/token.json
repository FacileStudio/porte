{
  "source": "github.com/FacileStudio/porte@v0.20.1",
  "subject": "token",
  "cases": [
    {
      "name": "hash empty",
      "input": {
        "kind": "hash",
        "token": ""
      },
      "want": {
        "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      }
    },
    {
      "name": "hash ascii",
      "input": {
        "kind": "hash",
        "token": "abc"
      },
      "want": {
        "hash": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
      }
    },
    {
      "name": "hash session shaped",
      "input": {
        "kind": "hash",
        "token": "dGhpcyBpcyBhIHNlc3Npb24gdG9rZW4gZm9yIHRlc3Rz"
      },
      "want": {
        "hash": "1e464e86b1067d97564348083c3ad62623b0ad9c0094096b7d105f5a573ad287"
      }
    },
    {
      "name": "hash utf8",
      "input": {
        "kind": "hash",
        "token": "é"
      },
      "want": {
        "hash": "4a99557e4033c3539de2eb65472017cad5f9557f7a0625a09f1c3f6e2ba69c4c"
      }
    },
    {
      "name": "new_token shape",
      "input": {
        "kind": "new_token"
      },
      "want": {
        "alphabet": "^[A-Za-z0-9_-]+$",
        "decoded_bytes": 32,
        "padding": false,
        "token_length": 43
      }
    },
    {
      "name": "new_browser_token shape",
      "input": {
        "kind": "new_browser_token"
      },
      "want": {
        "alphabet_after_prefix": "^[A-Za-z0-9_-]+$",
        "decoded_bytes_after_prefix": 32,
        "padding": false,
        "prefix": "b~",
        "token_length": 45
      }
    },
    {
      "name": "browser token as a bearer is not a browser session",
      "input": {
        "kind": "browser_session",
        "token": "b~AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "transport": "bearer",
        "label": ""
      },
      "want": {
        "browser_session": false
      }
    },
    {
      "name": "browser token in the cookie is a browser session",
      "input": {
        "kind": "browser_session",
        "token": "b~AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "transport": "cookie",
        "label": ""
      },
      "want": {
        "browser_session": true
      }
    },
    {
      "name": "browser token on a labelled row is not a browser session",
      "input": {
        "kind": "browser_session",
        "token": "b~AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "transport": "cookie",
        "label": "ci"
      },
      "want": {
        "browser_session": false
      }
    },
    {
      "name": "plain token in the cookie is not a browser session",
      "input": {
        "kind": "browser_session",
        "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "transport": "cookie",
        "label": ""
      },
      "want": {
        "browser_session": false
      }
    },
    {
      "name": "plain token starting with b- is not a browser session",
      "input": {
        "kind": "browser_session",
        "token": "b-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "transport": "cookie",
        "label": ""
      },
      "want": {
        "browser_session": false
      }
    },
    {
      "name": "compare equal",
      "input": {
        "a": "same",
        "b": "same",
        "kind": "compare"
      },
      "want": {
        "equal": true
      }
    },
    {
      "name": "compare case differs",
      "input": {
        "a": "same",
        "b": "Same",
        "kind": "compare"
      },
      "want": {
        "equal": false
      }
    },
    {
      "name": "compare prefix",
      "input": {
        "a": "short",
        "b": "shorter",
        "kind": "compare"
      },
      "want": {
        "equal": false
      }
    },
    {
      "name": "compare both empty",
      "input": {
        "a": "",
        "b": "",
        "kind": "compare"
      },
      "want": {
        "equal": true
      }
    },
    {
      "name": "compare one empty",
      "input": {
        "a": "a",
        "b": "",
        "kind": "compare"
      },
      "want": {
        "equal": false
      }
    }
  ]
}
